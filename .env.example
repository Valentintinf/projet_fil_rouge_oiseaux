# Modèle de configuration locale.
# À copier en .env (jamais commité) puis changer le mot de passe : cp .env.example .env
# Charger les variables dans le terminal : set -a && source .env && set +a

# Conteneur PostgreSQL (lu par Docker Compose)
POSTGRES_USER=oiseaux
POSTGRES_PASSWORD=a_changer
POSTGRES_DB=oiseaux

# Connexion des scripts Python (lu par psycopg)
PGHOST=localhost
PGPORT=5433
PGUSER=oiseaux
PGPASSWORD=a_changer
PGDATABASE=oiseaux

# Permet de lancer les modules : python -m oiseaux.ingestion.inaturalist
PYTHONPATH=src
